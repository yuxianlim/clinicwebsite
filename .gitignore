# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.npm-cache/
**/.npm/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.data/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.staging.example

# private deployment material
*.key
*.crt
*.cer
*.p12
*.pfx
*.ovpn
*.ppk
*.kdbx
*.doc
*.docx
*.pdf
*.ppt
*.pptx
*.xls
*.xlsx
id_rsa*
id_ed25519*
/.ssh/
/ssh/
/vpn/
/.npmrc
/private/
/secrets/
*.sqlite*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Browser test artifacts
/test-results/
/playwright-report/
