# Copy to .env.staging on Ubuntu only. Never commit the real file.
RELEASE_IMAGE=ghcr.io/yuxianlim/aven-staging@sha256:REPLACE_DIGEST
CADDY_IMAGE=caddy:2.10.2-alpine@sha256:REPLACE_VERIFIED_CADDY_DIGEST
CADDY_BIND_IP=REPLACE_SCHOOL_PROXY_FACING_SERVER_IP
CADDY_HOST_PORT=80
STAGING_PUBLIC_ORIGIN=https://aven.sean.tcmusa.ai
STAGING_BASIC_AUTH_USER=REPLACE_STAGING_USER
# Generate on Ubuntu with the reviewed CADDY_IMAGE, then single-quote the complete bcrypt value in this file so Compose treats every $ literally:
# docker run --rm "$CADDY_IMAGE" caddy hash-password --plaintext 'REPLACE_WITH_RANDOM_PASSWORD'
STAGING_BASIC_AUTH_HASH=REPLACE_CADDY_PASSWORD_HASH
CLINIC_ADMIN_EMAIL=REPLACE_ADMIN_EMAIL
CLINIC_ADMIN_PASSWORD=REPLACE_LONG_RANDOM_ADMIN_PASSWORD
CLINIC_ADMIN_TOTP_SECRET=REPLACE_BASE32_TOTP_SECRET
CLINIC_SESSION_SECRET=REPLACE_AT_LEAST_32_RANDOM_CHARACTERS
STRIPE_SECRET_KEY=sk_test_REPLACE_STRIPE_SANDBOX_SECRET
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_STRIPE_SANDBOX_PUBLISHABLE_KEY
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_STRIPE_SANDBOX_WEBHOOK_SECRET
# Live Stripe keys/events are rejected in fictional staging.
